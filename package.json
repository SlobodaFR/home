{
  "name": "@home/root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -ws --if-present",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint --fix",
    "format": "prettier --check ./apps ./packages",
    "format:write": "prettier --write",
    "export-diagram": "tsx packages/excalidraw-export/src/cli.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/js": "^9.0.0",
    "@semantic-release/changelog": "^6.0.0",
    "@semantic-release/git": "^10.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "semantic-release": "^24.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0",
    "@vitest/coverage-v8": "^3.0.0"
  },
  "lint-staged": {
    "./apps/**/*.{ts,mts,cts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "./packages/**/*.{ts,mts,cts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "./apps/**/*.{json,md,yml,yaml}": "prettier --write",
    "./packages/**/*.{json,md,yml,yaml}": "prettier --write"
  }
}
